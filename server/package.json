{
  "name": "@roblox-client-mcp/server",
  "version": "1.0.0",
  "private": true,
  "description": "Relay + MCP bridge that lets an AI drive a Roblox executor session.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
