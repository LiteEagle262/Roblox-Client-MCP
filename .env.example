# ---------------------------------------------------------------------------
# Roblox Client MCP - environment
# Copy to .env and edit. Every value below has a sane default except PUBLIC_URL.
# ---------------------------------------------------------------------------

# Port the Node server listens on (the container serves both the API and the web UI).
PORT=3000

# The public origin people will hit, with no trailing slash.
# This is what gets baked into generated loadstrings and the MCP endpoint URL.
# Local dev:  http://localhost:3000
# Production: https://roblox-mcp.yourdomain.com
PUBLIC_URL=http://localhost:3000

# SQLite file. Put this on a mounted volume in production.
DATABASE_PATH=/data/bridge.db

# Set to true when running behind a reverse proxy (Traefik/Dokploy) so the real
# client IP is read from X-Forwarded-For for rate limiting.
TRUST_PROXY=true

# --- Accounts -------------------------------------------------------------

# Turn account creation off to make an invite-only / personal instance.
ACCOUNT_CREATION_ENABLED=true

# Hard ceiling on total accounts. 0 = unlimited.
MAX_ACCOUNTS=0

# How many days a dashboard session stays valid.
SESSION_TTL_DAYS=30

# --- Rate limiting (per IP) ----------------------------------------------

RATE_LIMIT_ACCOUNT_PER_HOUR=3
RATE_LIMIT_ACCOUNT_PER_DAY=10
RATE_LIMIT_LOGIN_PER_15MIN=20
RATE_LIMIT_RELAY_PER_MIN=1200

# --- Relay / agents -------------------------------------------------------

# How long a Lua agent's long-poll request parks before returning empty.
AGENT_POLL_TIMEOUT_MS=25000

# How long the MCP server waits for an executor to answer a command.
COMMAND_TIMEOUT_MS=45000

# How many console lines a session keeps in its ring buffer.
CONSOLE_BUFFER_SIZE=1000

# Seconds without a heartbeat before a session is considered offline.
AGENT_STALE_SECONDS=45

# --- Optional admin -------------------------------------------------------

# If set, creating an account requires ?bootstrap=<value> or header
# x-bootstrap-secret. Leave empty for fully open public registration
# (still rate limited above).
BOOTSTRAP_SECRET=
